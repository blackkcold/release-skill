  "update_previous_dir": null,
  "update_artifact_glob": "*.dmg,*.zip,*.exe,*.AppImage,*.tar.gz,*.pkg",
  "release_assets": "",
  "delta_strategy": "auto",
  "delta_max": 2,
  "ignore_dirty": [".release.json", "release.config.json", ".DS_Store", "tmp/", "*.log"],
  "host": "auto",
  "lock_timeout_hours": 6,
