{
  "schemaVersion": 1,
  "provider": "auto",
  "repo": "",
  "tag_prefix": "v",
  "branch_model": "auto",
  "stable_branch": "main",
  "dev_branch": "develop",
  "dev_tag_suffix": "-dev",
  "target_branch": "auto",
  "version_strategy": "conventional",
  "project_name": "",
  "release_title": "{tag}",
  "build_command": null,
  "build_command_dev": null,
  "build_command_stable": null,
  "release_command": null,
  "test_command": null,
  "docs": ["CHANGELOG.md", "README.md"],
  "version_files": [],
  "changelog_format": "keep-a-changelog",
  "notes_style": "auto",
  "release_note_style": null,
  "ci_mode": "local",
  "release_branch": true,
  "pr_flow": "auto",
  "pr_cleanup": "report",
  "pr_cleanup_stale_days": 30,
  "main_sync": "ask",
  "experimental_paths": [],
